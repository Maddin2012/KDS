rules_version = '2';

// Sicherheitsregeln für die KDS Serviceliste.
//
// Modell (wie bei PlanPrepEat): Alle Daten hängen unter workshops/{code}.
// Der 16-stellige Code ist zugleich der Einladungscode. Wer ihn kennt, darf
// beitreten; wer nicht Mitglied ist, sieht nichts.
//
// „Ich bin“: Jedes Gerät trägt unter members/{uid} sein Monteur-Kürzel ein.
// Admins (SE, KÖ) dürfen Vorlagen ändern und Protokolle löschen – aber nur mit
// gültiger PIN. Die PIN steht nirgends im Code: In pins/{Kürzel} liegt nur ein
// Prüfwert (SHA-256 aus Werkstatt-Code, Kürzel und PIN), den kein Gerät lesen
// kann. Wer die PIN kennt, kann denselben Wert berechnen und damit unter
// adminClaims/{uid} einen Admin-Nachweis anlegen; die Regeln vergleichen ihn
// serverseitig mit pins/{Kürzel}.
// ADMINS muss mit data.js übereinstimmen.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(wid) {
      return signedIn()
        && get(/databases/$(database)/documents/workshops/$(wid))
             .data.members[request.auth.uid] == true;
    }

    function adminCodes() {
      return ['SE', 'KÖ'];
    }


    // Gültiger Admin-Nachweis: Prüfwert stimmt mit der aktuellen PIN überein.
    // Wird eine PIN geändert, verlieren alte Nachweise sofort ihre Wirkung.
    function claimValid(wid, claim) {
      return claim.monteur in adminCodes()
        && exists(/databases/$(database)/documents/workshops/$(wid)/pins/$(claim.monteur))
        && claim.hash == get(/databases/$(database)/documents/workshops/$(wid)/pins/$(claim.monteur)).data.hash;
    }

    function isAdmin(wid) {
      return isMember(wid)
        && exists(/databases/$(database)/documents/workshops/$(wid)/adminClaims/$(request.auth.uid))
        && claimValid(wid, get(/databases/$(database)/documents/workshops/$(wid)/adminClaims/$(request.auth.uid)).data);
    }

    // PIN zurücksetzen mit Wiederherstellungs-Code: `rec` muss zum gespeicherten
    // Prüfwert passen.
    function recoveryOk(wid, code, data) {
      return 'rec' in data
        && exists(/databases/$(database)/documents/workshops/$(wid)/recoveries/$(code))
        && data.rec == get(/databases/$(database)/documents/workshops/$(wid)/recoveries/$(code)).data.hash;
    }

    // Bestandsänderung durch Nicht-Admins: nur Bestandsfelder, nur mit neuer Buchung
    // (Zulauf: alt + Menge, Entnahme: alt − Menge, nie unter 0).
    function bookingUpdateOk(wid, aid) {
      let b = getAfter(/databases/$(database)/documents/workshops/$(wid)/artikel/$(aid)/buchungen/$(request.resource.data.lastBooking)).data;
      return isMember(wid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bestand', 'bestandAt', 'bestandVon', 'lastBooking'])
        && request.resource.data.bestand is number && request.resource.data.bestand >= 0
        && !exists(/databases/$(database)/documents/workshops/$(wid)/artikel/$(aid)/buchungen/$(request.resource.data.lastBooking))
        && b.menge is number && b.menge > 0
        && ((b.typ == 'Zulauf' && request.resource.data.bestand == resource.data.bestand + b.menge)
            || (b.typ == 'Entnahme' && request.resource.data.bestand == resource.data.bestand - b.menge));
    }

    // Allererste PIN einer Werkstatt: nur solange noch keine einzige gesetzt ist.
    function noPinsYet(wid) {
      return !exists(/databases/$(database)/documents/workshops/$(wid)/pins/$('SE'))
        && !exists(/databases/$(database)/documents/workshops/$(wid)/pins/$('KÖ'));
    }

    // Beitritt: Nur das Feld `members` und darin nur der eigene Eintrag.
    function isSelfJoin() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        // ausgesperrte Geräte (Eintrag false) dürfen nicht selbst wieder beitreten
        && resource.data.members.get(request.auth.uid, null) == null;
    }

    // Auftrag noch nicht abgeschlossen – oder Admin
    function orderOpenOrAdmin(wid, oid) {
      return isAdmin(wid)
        || get(/databases/$(database)/documents/workshops/$(wid)/auftraege/$(oid)).data.get('status', 'offen') != 'fertig';
    }

    // Gesperrte Kürzel (Feld `gesperrt` im Werkstatt-Dokument)
    function blockedCodes(wid) {
      return get(/databases/$(database)/documents/workshops/$(wid)).data.get('gesperrt', []);
    }

    match /workshops/{wid} {
      // Einzelnes get() für jeden Angemeldeten, damit ein falscher Code eine
      // verständliche Meldung ergibt. Auflisten aller Werkstätten ist verboten.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.members[request.auth.uid] == true;

      // Mitgliederliste und Sperren ändern nur Admins (bzw. der eigene Beitritt);
      // Admin-Kürzel können nie gesperrt werden.
      allow update: if !request.resource.data.get('gesperrt', []).hasAny(adminCodes())
        && (isAdmin(wid) || isSelfJoin()
            || (isMember(wid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'gesperrt'])));
      allow delete: if false;

      // „Ich bin“ je Gerät: lesen dürfen alle Mitglieder, schreiben nur den eigenen
      // Eintrag. Ein Admin-Kürzel nur mit gültigem Admin-Nachweis (gleiche Sammelbuchung).
      match /members/{uid} {
        allow read: if isMember(wid);
        allow delete: if isMember(wid) && request.auth.uid == uid;
        allow create, update: if isMember(wid) && request.auth.uid == uid
          && !(request.resource.data.monteur in blockedCodes(wid))
          && (!(request.resource.data.monteur in adminCodes())
              || (existsAfter(/databases/$(database)/documents/workshops/$(wid)/adminClaims/$(uid))
                  && getAfter(/databases/$(database)/documents/workshops/$(wid)/adminClaims/$(uid)).data.monteur
                       == request.resource.data.monteur
                  && claimValid(wid, getAfter(/databases/$(database)/documents/workshops/$(wid)/adminClaims/$(uid)).data)));
      }

      // PIN-Prüfwerte: für niemanden lesbar. Setzen/ändern dürfen
      //  · Admins (auch für den anderen Admin – „PIN zurücksetzen“),
      //  · bei der Einrichtung jedes Mitglied die allererste PIN,
      //  · wer den Wiederherstellungs-Code dieses Kürzels kennt (Feld `rec`).
      match /pins/{code} {
        allow read: if false;
        allow create, update: if isMember(wid) && code in adminCodes()
          && request.resource.data.keys().hasOnly(['hash', 'rec'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64
          && (isAdmin(wid) || noPinsYet(wid) || recoveryOk(wid, code, request.resource.data));
        allow delete: if isAdmin(wid);
      }

      // Wiederherstellungs-Codes: nur ein Prüfwert, für niemanden lesbar.
      // Anlegen/erneuern: Admins, die Einrichtung, oder wer den bisherigen Code
      // kennt (Feld `prev` = Prüfwert des alten Codes – beim Zurücksetzen).
      match /recoveries/{code} {
        allow read: if false;
        allow create, update: if isMember(wid) && code in adminCodes()
          && request.resource.data.keys().hasOnly(['hash', 'prev'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64
          && (isAdmin(wid) || noPinsYet(wid)
              || (resource != null && request.resource.data.get('prev', '') == resource.data.hash));
        allow delete: if isAdmin(wid);
      }

      // Öffentlicher Hinweis „für dieses Kürzel gibt es eine PIN“ (ohne Prüfwert),
      // damit die App weiß, ob sie nach der PIN fragt oder sie festlegen lässt.
      match /pinFlags/{code} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && code in adminCodes()
          && existsAfter(/databases/$(database)/documents/workshops/$(wid)/pins/$(code));
        allow delete: if isAdmin(wid);
      }

      // Admin-Nachweis je Gerät: nur das eigene Gerät, nur mit richtiger PIN.
      match /adminClaims/{uid} {
        allow read, delete: if isMember(wid) && request.auth.uid == uid;
        allow create, update: if isMember(wid) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['monteur', 'hash'])
          && claimValid(wid, request.resource.data);
      }

      // Vorlagen: lesen alle Mitglieder, ändern nur Admins.
      match /templates/{cat} {
        allow read: if isMember(wid);
        allow write: if isAdmin(wid);
      }

      // Lager: Artikel-Stammdaten nur Admins. Den Bestand ändern alle – aber nur zusammen
      // mit einer neuen Buchung (gleiche Transaktion), deren Rechnung stimmen muss.
      match /artikel/{aid} {
        allow read: if isMember(wid);
        allow create, delete: if isAdmin(wid);
        allow update: if isAdmin(wid) || bookingUpdateOk(wid, aid);

        match /buchungen/{bid} {
          allow read: if isMember(wid);
          allow create: if isMember(wid)
            && request.resource.data.typ in ['Zulauf', 'Entnahme', 'Korrektur']
            && (request.resource.data.typ != 'Korrektur' || isAdmin(wid))
            && request.resource.data.menge is number
            && request.resource.data.bestandNachher
                 == getAfter(/databases/$(database)/documents/workshops/$(wid)/artikel/$(aid)).data.bestand
            && getAfter(/databases/$(database)/documents/workshops/$(wid)/artikel/$(aid)).data.lastBooking == bid;
          allow update: if false;
          allow delete: if isAdmin(wid);
        }
      }

      // Lager-Einstellungen (Kategorien, Lagerorte): lesen alle, ändern Admins.
      match /einstellungen/{name} {
        allow read: if isMember(wid);
        allow write: if isAdmin(wid);
      }

      // Werkstattaufträge: anlegen, lesen und bearbeiten alle Mitglieder, löschen nur Admins.
      // Die Auftragsnummer bleibt nach dem Anlegen unverändert.
      // Abgeschlossene Aufträge (status „fertig“) ändern nur noch Admins.
      match /auftraege/{oid} {
        allow read: if isMember(wid);
        allow create: if isMember(wid)
          && request.resource.data.nr is string && request.resource.data.nr.size() > 0 && request.resource.data.nr.size() < 80;
        allow update: if isMember(wid) && request.resource.data.nr == resource.data.nr
          && (resource.data.get('status', 'offen') != 'fertig' || isAdmin(wid))
          // endgültig abschließen (2/2) nur Admins
          && (request.resource.data.get('status', 'offen') != 'fertig' || isAdmin(wid));
        allow delete: if isAdmin(wid);

        // Anhänge (Bilder, PDF, Videos …): alle Mitglieder hängen an, solange der Auftrag
        // nicht abgeschlossen ist (danach nur Admins); löschen Admins oder wer angehängt hat.
        match /dateien/{fid} {
          allow read: if isMember(wid);
          allow create: if isMember(wid) && request.resource.data.uid == request.auth.uid
            && request.resource.data.name is string && orderOpenOrAdmin(wid, oid);
          allow update: if false;
          allow delete: if isAdmin(wid) || (isMember(wid) && resource.data.uid == request.auth.uid && orderOpenOrAdmin(wid, oid));
          match /teile/{n} {
            allow read: if isMember(wid);
            allow create: if isMember(wid) && request.resource.data.data is string && request.resource.data.data.size() <= 800000
              && !exists(/databases/$(database)/documents/workshops/$(wid)/auftraege/$(oid)/dateien/$(fid));
            allow update: if false;
            allow delete: if isAdmin(wid) || (isMember(wid)
              && (!exists(/databases/$(database)/documents/workshops/$(wid)/auftraege/$(oid)/dateien/$(fid))
                  || get(/databases/$(database)/documents/workshops/$(wid)/auftraege/$(oid)/dateien/$(fid)).data.uid == request.auth.uid));
          }
        }
      }

      // Fahrzeugakte: Ersatzteile und Ölsorten pflegen Admins; Notizen und Dateien
      // (Bilder, Dokumente, Liebherr-Arbeitsberichte) legen alle Mitglieder an,
      // löschen dürfen Admins oder wer sie angelegt hat. Dateien liegen in Stücken
      // unter dateien/{fid}/teile (Firestore-Dokumente sind auf 1 MB begrenzt).
      match /akten/{vid} {
        allow read: if isMember(wid);
        allow create, update, delete: if isAdmin(wid);

        match /notizen/{nid} {
          allow read: if isMember(wid);
          allow create: if isMember(wid) && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 20000;
          allow update: if false;
          allow delete: if isAdmin(wid) || (isMember(wid) && resource.data.uid == request.auth.uid);
        }

        match /dateien/{fid} {
          allow read: if isMember(wid);
          allow create: if isMember(wid) && request.resource.data.uid == request.auth.uid
            && request.resource.data.kind in ['bild', 'dok', 'lbh'] && request.resource.data.name is string;
          allow update: if false;
          allow delete: if isAdmin(wid) || (isMember(wid) && resource.data.uid == request.auth.uid);

          match /teile/{n} {
            allow read: if isMember(wid);
            allow create: if isMember(wid) && request.resource.data.data is string && request.resource.data.data.size() <= 800000
              && !exists(/databases/$(database)/documents/workshops/$(wid)/akten/$(vid)/dateien/$(fid));
            allow update: if false;
            allow delete: if isAdmin(wid) || (isMember(wid)
              && (!exists(/databases/$(database)/documents/workshops/$(wid)/akten/$(vid)/dateien/$(fid))
                  || get(/databases/$(database)/documents/workshops/$(wid)/akten/$(vid)/dateien/$(fid)).data.uid == request.auth.uid));
          }
        }
      }

      // Laufende Servicelisten (Live-Übersicht): jedes Gerät schreibt nur seine eigenen
      // (Kennung „<uid>_<Kategorie>“); lesen alle Mitglieder; löschen Ersteller oder Admins.
      match /laufend/{rid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && request.resource.data.uid == request.auth.uid
          && rid.matches(request.auth.uid + '_.+');
        allow delete: if isMember(wid) && (rid.matches(request.auth.uid + '_.+') || isAdmin(wid));
      }

      // Zähler für fortlaufende Auftragsnummern: nur um genau 1 hochzählen.
      match /zaehler/{key} {
        allow read: if isMember(wid);
        allow create: if isMember(wid) && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
        allow update: if isMember(wid) && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
        allow delete: if false;
      }

      // Fuhrpark: lesen alle Mitglieder, anlegen/ändern/löschen nur Admins.
      // „Letzter Service“ darf jedes Mitglied setzen (beim Abschluss einer Serviceliste).
      match /fahrzeuge/{vid} {
        allow read: if isMember(wid);
        allow create, delete: if isAdmin(wid);
        allow update: if isAdmin(wid)
          || (isMember(wid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letzterService', 'letzterServiceVon'])
              && request.resource.data.letzterService is string);
      }

      // Abgeschlossene Protokolle: anlegen und lesen alle Mitglieder.
      // Nachträglich bearbeiten und löschen nur Admins (mit PIN). Beim Bearbeiten
      // bleiben Kategorie, „abgeschlossen von“ und Abschlusszeit unveränderlich.
      match /protocols/{pid} {
        allow read, create: if isMember(wid);
        allow update: if isAdmin(wid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['header', 'monteure', 'groups', 'editedBy', 'editedAt', 'edits']);
        allow delete: if isAdmin(wid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
